# Application Configuration
PORT=5000
NODE_ENV=development

# Database & Cache
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.ghfpv6i.mongodb.net/
REDIS_URL=redis://localhost:6379

# Authentication & JWT (At least 32 characters each)
JWT_ACCESS_SECRET=becha_kena_jwt_access_secret_super_secure_32chars_min
JWT_REFRESH_SECRET=becha_kena_jwt_refresh_secret_super_secure_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cryptography & Security Vaults
# KMS_SECRET_KEY must be exactly 32 bytes (64 hex characters)
KMS_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
HMAC_SALT=becha_kena_nid_salt_secure_random_key_min32chars_length

# Object Storage (AWS S3 or MinIO)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=becha-kena-uploads
AWS_ACCESS_KEY_ID=mock_aws_access_key_id
AWS_SECRET_ACCESS_KEY=mock_aws_secret_access_key

# KYC Provider Configuration
KYC_PROVIDER=mock
PORICHOY_API_KEY=mock_porichoy_api_key
PORICHOY_BASE_URL=https://api.porichoybd.com

# SMS Provider Configuration
SMS_PROVIDER=mock
ALPHA_SMS_API_KEY=mock_alpha_sms_api_key

# Client URLs (for CORS)
CLIENT_URL=http://localhost:3000
